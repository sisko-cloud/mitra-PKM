{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/(build|css|js|images|fonts)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "Mitra PKM",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_URL": "https://mitra-pkm.vercel.app",
    "APP_STORAGE": "/tmp/storage",
    "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "SESSION_SECURE_COOKIE": "true",
    "APP_KEY": "base64:1Fe/YQY825/0YUHIRAg9la0OvrLNR8d3rOCSF9l23Ho=",
    "DATABASE_URL": "postgresql://neondb_owner:npg_7qJt9DGguCOv@ep-twilight-dew-bedj2gnb-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require",
    "DB_CONNECTION": "pgsql",
    "DB_PORT": "5432",
    "DB_SSLMODE": "require"
  }
}
